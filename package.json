{
  "name": "last-vector",
  "version": "0.1.0",
  "private": true,
  "description": "LAST-VECTOR — multiplayer alien-strike arena shooter. React + PixiJS + Rapier client, Node + Colyseus server.",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w shared && npm run build -w client && npm run build -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "start:server": "npm run start -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "clean": "rimraf client/dist server/dist shared/dist",
    "check": "node tools/check/visual-check.mjs",
    "probe": "node tools/check/probe.mjs",
    "probe:stress": "node tools/check/probe-stress.mjs",
    "probe:resize": "node tools/check/probe-resize.mjs",
    "mobile:sync": "npm run build -w client && npm run cap:sync -w client",
    "mobile:android": "npm run cap:android -w client",
    "mobile:ios": "npm run cap:ios -w client",
    "mobile:assets": "npm run cap:assets -w client",
    "mobile:apk": "npm run mobile:sync && npm run android:debug -w client",
    "mobile:apk:release": "npm run mobile:sync && npm run android:release -w client"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
