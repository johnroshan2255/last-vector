# copy to android/keystore.properties (git-ignored) and fill in
# create the keystore once:
#   keytool -genkeypair -v -keystore android/last-vector.jks -alias lastvector -keyalg RSA -keysize 2048 -validity 10000
storeFile=last-vector.jks
storePassword=CHANGE_ME
keyAlias=lastvector
keyPassword=CHANGE_ME
