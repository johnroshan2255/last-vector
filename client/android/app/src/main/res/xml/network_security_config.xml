<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (ws:// / http://) is OFF by default and only opened for local-play hosts.
  Android's network security config matches by hostname, not by IP range, so LAN
  servers must be listed explicitly (or reached via an mDNS *.local name).
  Add the LAN IPs you host on below; the production server must use wss://.
-->
<network-security-config>
    <!-- everything not listed below: TLS only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- local network only -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- the WebView itself serves the bundle from http://localhost -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Android emulator alias for the host machine -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- mDNS / Bonjour names, e.g. my-mac.local -->
        <domain includeSubdomains="true">local</domain>
        <!-- LAN hosts you run the Colyseus server on (edit to match your network) -->
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
    </domain-config>
</network-security-config>
