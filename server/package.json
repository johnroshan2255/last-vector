{
  "name": "@last-vector/server",
  "version": "0.1.0",
  "private": true,
  "description": "LAST-VECTOR authoritative multiplayer server \u2014 Node.js + Colyseus + server-side Rapier.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "loadtest": "colyseus-loadtest"
  },
  "dependencies": {
    "@last-vector/shared": "*",
    "@colyseus/monitor": "^0.16.7",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.5",
    "@dimforge/rapier2d-compat": "^0.20.0",
    "colyseus": "^0.16.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@colyseus/loadtest": "^0.16.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3"
  }
}
