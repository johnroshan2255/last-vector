{
  "name": "@last-vector/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Constants and types shared by the LAST-VECTOR client and server \u2014 single source of truth.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.20.0"
  }
}
